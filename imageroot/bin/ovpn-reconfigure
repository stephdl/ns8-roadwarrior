# Run configure-module with the saved settings after a clone, a move or a restore.
# The tun, its firewall zone, the public port and the user domain binding belong to the node,
# so the copy must create them again. The PKI comes with the state: profiles stay valid.
#
# If the original instance still runs on this node, its port and network conflict.
# The copy then stays stopped and leaves a marker: the module-removed event starts it
# once the original is gone. Other validation errors need the admin, not a retry.

import json
import os
import subprocess
import sys
import agent
import ovpn_module as om

conf = om.settings()
if om.mode() == "spoke" and not om.join_is_mine():
    # Two nodes with one certificate would kick each other off the link: the clone joins on its own
    om.forget_join()
if om.mode() == "spoke":
    data = {"mode": "spoke", "hub": om.current_hub(agent.redis_connect(use_replica=True)),
            "expose_samba": om.is_true(conf["OVPN_EXPOSE_SAMBA"]),
            "expose_ssh": om.is_true(conf["OVPN_EXPOSE_SSH"])}
elif not conf["OVPN_HOST"]:
    sys.exit(0)
else:
    data = {
        "mode": om.mode(),
        "host": conf["OVPN_HOST"],
        "port": int(conf["OVPN_PORT"]),
        "network": conf["OVPN_NETWORK"],
        "auth_mode": conf["OVPN_AUTH_MODE"],
        "user_domain": conf["OVPN_USER_DOMAIN"],
        "totp_required": om.is_true(conf["OVPN_TOTP_REQUIRED"]),
        "expose_samba": om.is_true(conf["OVPN_EXPOSE_SAMBA"]),
        "expose_ssh": om.is_true(conf["OVPN_EXPOSE_SSH"]),
    }
# Errors an original instance on the same node causes, and that its removal clears
CONFLICTS = {("network", "network_overlap"), ("port", "port_in_use")}

response = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data=data)
if response["exit_code"] == 2:
    subprocess.run(["systemctl", "--user", "disable", "--now", *om.ALL_UNITS], check=False)
    errors = response["output"] if isinstance(response["output"], list) else []
    if errors and all((e.get("parameter"), e.get("error")) in CONFLICTS for e in errors):
        open(om.WAITING, "w").close()
        print(agent.SD_WARNING + "The VPN stays stopped until the instance that holds its network and port is removed: "
              + json.dumps(errors), file=sys.stderr)
    else:
        print(agent.SD_WARNING + "The VPN stays stopped, its settings are not valid on this node. Fix them and save again: "
              + json.dumps(response["output"]), file=sys.stderr)
    sys.exit(0)
agent.assert_exp(response["exit_code"] == 0, "configure-module failed")
if os.path.exists(om.WAITING):
    os.unlink(om.WAITING)
