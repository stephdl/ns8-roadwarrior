# A node of this hub saved its settings: push the DC route and realm it now shares, or not.

import json
import os
import sys
import ovpn_module as om

event = json.load(sys.stdin)
if om.mode() != "hub" or not om.server_running():
    sys.exit(0)
if event.get("module_uuid") not in om.load_json(om.SPOKES, {}):
    sys.exit(0)
om.apply_runtime(om.write_runtime())
