# Traefik publishes this event when its host names change. New apps must resolve to the address
# of the node that serves them.

import json
import os
import sys
import agent
import ovpn_module as om

event = json.load(sys.stdin)
if not om.is_configured() or om.mode() == "spoke":
    sys.exit(0)
nodes = {os.environ["NODE_ID"]}
nodes |= {info["node_id"] for info in om.current_spokes(agent.redis_connect(use_replica=True)).values()}
if str(event.get("node_id")) not in nodes:
    sys.exit(0)
# A new domain changes what the server pushes: clients reconnect on their own
om.apply_runtime(om.write_runtime())
