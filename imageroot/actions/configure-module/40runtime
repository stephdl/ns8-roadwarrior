import ovpn_module as om

# ovpn-auth reads auth.json at each login: only server.env changes need a restart.
# A spoke learns its address from the hub at each save: its session must start again.
if om.write_runtime() or om.mode() == "spoke" or not om.server_running():
    open("ovpn/restart-needed", "w").close()
