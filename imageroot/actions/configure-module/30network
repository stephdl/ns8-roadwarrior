# OpenVPN creates the tun and its address. The core owns the zone and the public port.
# Clients reach this node alone: no forward, so Traefik and samba see the VPN address of the client.

import os
import agent
import ovpn_module as om

conf = om.settings()
tun = os.environ["OVPN_TUN"]
net, _ = om.network_parts(conf["OVPN_NETWORK"])

# The core refuses an empty rule list. SSH stays closed to the VPN clients.
rules = [f"rule family=ipv4 source address={net.with_prefixlen} port port=22 protocol=tcp reject"]
agent.assert_exp(agent.add_custom_zone(tun, tun, om.firewall_ports(om.is_true(conf["OVPN_EXPOSE_SAMBA"])), rules),
                 "firewall zone configuration failed")
agent.assert_exp(agent.add_public_service(os.environ["MODULE_ID"], [f"{conf['OVPN_PORT']}/udp"], replace_ports=True),
                 "firewall port configuration failed")
