# The core owns the tun, its zone and the public port: the module runs rootless and only asks for them.
# The node never forwards: Traefik and samba see the VPN address of the client. On a hub and on
# a spoke this tun is the end of the link with the hub, and the hub forwards in its own namespace.

import os
import subprocess
import agent
import ovpn_module as om

conf = om.settings()
tun = os.environ["OVPN_TUN"]
tun_ip = om.host_tun_ip(conf)

# tun-manager only sets the address when it starts: a new network needs a new tun.
# A clone or a restore lands on a node without the tun, whatever OVPN_TUN_IP says.
tun_exists = os.path.exists(f"/sys/class/net/{tun}")
if not tun_exists or os.environ.get("OVPN_TUN_IP") != tun_ip:
    if tun_exists:
        # OpenVPN holds the tun open: tun-manager cannot delete a busy device
        subprocess.run(["systemctl", "--user", "stop", *om.ALL_UNITS], check=False)
        agent.remove_tun(tun)
    agent.assert_exp(agent.add_tun(tun, tun_ip), "tun creation failed")
    agent.set_env("OVPN_TUN_IP", tun_ip)

# Nothing tells the module when sshd moves: the settings show the ports found at the last save
ssh_ports = om.ssh_ports()
agent.set_env("OVPN_SSH_PORTS", " ".join(ssh_ports))
rules = om.zone_rules(om.is_true(conf["OVPN_EXPOSE_SSH"]), ssh_ports)
agent.assert_exp(agent.add_custom_zone(tun, tun, om.firewall_ports(om.is_true(conf["OVPN_EXPOSE_SAMBA"])), rules),
                 "firewall zone configuration failed")
if om.mode() == "spoke":
    # The hub is reached through the cluster VPN: a spoke opens nothing to Internet
    agent.remove_public_service(os.environ["MODULE_ID"])
else:
    # The site-to-site port of a hub listens on the cluster VPN only, already open between the nodes
    agent.assert_exp(agent.add_public_service(os.environ["MODULE_ID"], [f"{conf['OVPN_PORT']}/udp"], replace_ports=True),
                     "firewall port configuration failed")
