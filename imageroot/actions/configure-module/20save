import json
import os
import sys
import agent
import ovpn_module as om

request = json.load(sys.stdin)
mode = request.get("mode", "standalone")

if mode != "spoke" and os.path.exists(om.SPOKE_JOIN):
    # The old hub keeps the node in its list until the admin removes it there
    os.unlink(om.SPOKE_JOIN)
if om.mode() == "hub" and mode != "hub":
    # Validation left only the spoke of this node: its address goes with the link
    om.save_spokes({})

agent.set_env("OVPN_MODE", mode)
agent.set_env("OVPN_HUB", request["hub"] if mode == "spoke" else "")
agent.set_env("OVPN_EXPOSE_SAMBA", str(bool(request.get("expose_samba"))))
if mode == "spoke":
    if request.get("join"):
        om.save_join(request["join"])
    join = om.load_join()
    agent.set_env("OVPN_SPOKE_IP", join["ip"])
    agent.set_env("OVPN_RW_NETWORK", join["rw_network"])
    # A spoke keeps the user settings it had, so a return to standalone finds them again
    agent.bind_user_domains([])
    sys.exit(0)

password_mode = request["auth_mode"] == "certificate_password"
domain = request.get("user_domain", "") if password_mode else ""

agent.set_env("OVPN_HOST", request["host"])
agent.set_env("OVPN_PORT", str(request["port"]))
agent.set_env("OVPN_NETWORK", request["network"])
agent.set_env("OVPN_AUTH_MODE", request["auth_mode"])
agent.set_env("OVPN_USER_DOMAIN", domain)
agent.set_env("OVPN_TOTP_REQUIRED", str(bool(request.get("totp_required")) and password_mode))
agent.bind_user_domains([domain] if domain else [])

if mode == "hub":
    # The nodes join on the cluster VPN address of this node, on a port of the node allocator
    rdb = agent.redis_connect(use_replica=True)
    agent.set_env("OVPN_VPN_IP", om.node_vpn_ip(rdb, os.environ["NODE_ID"]))
    # The core reserved this port at install, from the udp-ports-demand label
    agent.set_env("OVPN_S2S_PORT", os.environ["UDP_PORT"])
