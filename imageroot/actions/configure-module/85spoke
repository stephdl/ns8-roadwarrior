# A hub reaches the apps of its own node like those of the others: through a spoke of this node.
# Its site-to-site server runs now, so it can sign the certificate of that spoke.

import os
import subprocess
import ovpn_module as om

# Signing again revokes the certificate in use and drops the link of this node: do it only when needed
if om.mode() == "hub" and not om.own_spoke_is_valid():
    joined = om.register_spoke(os.environ["MODULE_ID"], os.environ["MODULE_UUID"], os.environ["NODE_ID"],
                               om.spoke_key_and_csr())
    om.save_spoke_certs(joined["ca"], joined["cert"])
    # The ccd file of this spoke and its routes come with the registration
    om.apply_runtime(om.write_runtime())
    # The spoke of this node joins with the certificate just signed
    subprocess.run(["systemctl", "--user", "restart", "openvpn-spoke.service"], check=True)
