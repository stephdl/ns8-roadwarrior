import ipaddress
import json
import os
import subprocess
import sys
import agent
import agent.ldapproxy
import ovpn_module as om

request = json.load(sys.stdin)
mode = request.get("mode", "standalone")
rdb = agent.redis_connect(use_replica=True)

# The other nodes of a hub reach its users: they must not lose them silently
if om.mode() == "hub" and mode != "hub":
    if any(spoke != os.environ["MODULE_ID"] for spoke in om.load_spokes()):
        om.fail_validation("mode", mode, "hub_has_spokes")

if mode == "spoke":
    # A spoke has no users: their profiles would stop working
    if om.load_accounts():
        om.fail_validation("mode", mode, "accounts_exist")
    if request["hub"] not in [hub["module_id"] for hub in om.list_hubs(rdb)]:
        om.fail_validation("hub", request["hub"], "hub_not_found")
    sys.exit(0)

try:
    net, _ = om.network_parts(request["network"])
except ValueError:
    om.fail_validation("network", request["network"], "invalid_network")
if net.version != 4 or not net.is_private or not 16 <= net.prefixlen <= 28:
    om.fail_validation("network", request["network"], "network_not_allowed")
# A hub also takes the network next to it for the link with the nodes
wanted = om.s2s_networks(request["network"])["supernet"] if mode == "hub" else net
# The cluster VPN and the networks of the node must stay reachable
taken = []
cluster_net = rdb.get("cluster/network")
if cluster_net:
    taken.append(ipaddress.ip_network(cluster_net, strict=False))
addrs = json.loads(subprocess.run(["ip", "-j", "-4", "addr"], capture_output=True, text=True, check=True).stdout)
for iface in addrs:
    if iface["ifname"] == os.environ.get("OVPN_TUN"):
        continue
    for info in iface.get("addr_info", []):
        taken.append(ipaddress.ip_network(f"{info['local']}/{info['prefixlen']}", strict=False))
if any(wanted.overlaps(other) for other in taken):
    om.fail_validation("network", request["network"], "network_overlap")

# A running server of this instance holds its own port: that one is not a conflict
own_port = om.server_running() and str(request["port"]) == os.environ.get("OVPN_PORT")
if not own_port and om.udp_port_in_use(request["port"]):
    om.fail_validation("port", request["port"], "port_in_use")

# Host and port are written in every profile already sent, the network in the HTTP route allowlists
if om.load_accounts():
    current = om.settings()
    if request["host"] != current["OVPN_HOST"]:
        om.fail_validation("host", request["host"], "host_locked")
    if str(request["port"]) != current["OVPN_PORT"]:
        om.fail_validation("port", request["port"], "port_locked")
    if request["network"] != current["OVPN_NETWORK"]:
        om.fail_validation("network", request["network"], "network_locked")
    # Profiles hold the login prompt of the mode they were made with
    if request["auth_mode"] != current["OVPN_AUTH_MODE"]:
        om.fail_validation("auth_mode", request["auth_mode"], "auth_mode_locked")

if request["auth_mode"] == "certificate_password":
    domain = request.get("user_domain", "")
    if not domain:
        om.fail_validation("user_domain", domain, "user_domain_required")
    if domain not in agent.ldapproxy.Ldapproxy().get_domains_list():
        om.fail_validation("user_domain", domain, "user_domain_not_found")
elif request.get("totp_required"):
    om.fail_validation("totp_required", True, "totp_needs_password")
