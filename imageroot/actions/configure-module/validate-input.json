{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure roadwarrior",
    "$id": "http://schema.nethserver.org/roadwarrior/configure-module-input.json",
    "description": "Configure the OpenVPN road warrior server of this node",
    "examples": [
        {
            "host": "vpn.example.org",
            "port": 1194,
            "network": "10.8.0.0/24",
            "auth_mode": "certificate_password",
            "user_domain": "example.org",
            "totp_required": false,
            "expose_samba": true,
            "mode": "hub"
        },
        {
            "mode": "spoke",
            "hub": "roadwarrior1",
            "expose_samba": true
        }
    ],
    "type": "object",
    "properties": {
        "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9.:-]+$",
            "description": "Public host name or IP address the clients connect to"
        },
        "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535,
            "description": "Public UDP port of the server"
        },
        "network": {
            "type": "string",
            "description": "IPv4 network of the VPN clients, like 10.8.0.0/24"
        },
        "auth_mode": {
            "type": "string",
            "enum": [
                "certificate",
                "certificate_password"
            ],
            "description": "certificate: the client certificate alone. certificate_password: the certificate and the password of the user domain."
        },
        "user_domain": {
            "type": "string",
            "description": "User domain checked for the password. Required with certificate_password."
        },
        "totp_required": {
            "type": "boolean",
            "description": "Refuse password logins of accounts without an authenticator"
        },
        "expose_samba": {
            "type": "boolean",
            "description": "Open the samba DC of this node to the VPN clients"
        },
        "mode": {
            "type": "string",
            "enum": [
                "standalone",
                "hub",
                "spoke"
            ],
            "description": "standalone: the users reach this node. hub: the users reach every node that joins this instance. spoke: this node joins a hub and has no users."
        },
        "hub": {
            "type": "string",
            "pattern": "^roadwarrior[0-9]+$",
            "description": "Instance of the hub this node joins. Required with spoke."
        },
        "join": {
            "type": "object",
            "description": "Output of add-spoke of the hub. Without it a spoke keeps what it got last time from the same hub.",
            "required": [
                "hub",
                "ip",
                "rw_network",
                "ca",
                "cert"
            ],
            "properties": {
                "hub": {
                    "type": "string"
                },
                "ip": {
                    "type": "string",
                    "pattern": "^[0-9.]+/[0-9]+$"
                },
                "rw_network": {
                    "type": "string",
                    "pattern": "^[0-9.]+/[0-9]+$"
                },
                "ca": {
                    "type": "string"
                },
                "cert": {
                    "type": "string"
                },
                "hub_uuid": {
                    "type": "string"
                }
            }
        }
    },
    "if": {
        "properties": {
            "mode": {
                "const": "spoke"
            }
        },
        "required": [
            "mode"
        ]
    },
    "then": {
        "required": [
            "hub"
        ]
    },
    "else": {
        "required": [
            "host",
            "port",
            "network",
            "auth_mode"
        ]
    }
}
