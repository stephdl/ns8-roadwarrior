set -e
exec 1>&2

rm -f waiting-for-original
systemctl enable "${MODULE_ID}-openvpn-server.service" "${MODULE_ID}-openvpn-dns.service"
if [ -e ovpn/restart-needed ]; then
    systemctl restart "${MODULE_ID}-openvpn-server.service" "${MODULE_ID}-openvpn-dns.service"
    rm -f ovpn/restart-needed
else
    # Only the resolver lists changed: no client is dropped
    systemctl reload-or-restart "${MODULE_ID}-openvpn-dns.service"
fi
