# The certificate stays valid: enable-account gives the access back with the same profile

import json
import sys
import ovpn_module as om

request = json.load(sys.stdin)
name = request["name"]
accounts = om.load_accounts()
if name not in accounts:
    om.fail_validation("name", name, "account_not_found")
accounts[name]["disabled"] = True
om.save_accounts(accounts)
if om.server_running():
    om.podman_exec("ovpn-mgmt", "kill", name, check=False)
