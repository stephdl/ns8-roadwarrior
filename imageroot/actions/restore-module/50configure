# The core restored the PKI volume before this step. The same host, port and CA keep every profile valid.

import json
import os
import sys
import agent
import ovpn_module as om

request = json.load(sys.stdin)
conf = om.settings(request["environment"])
if not conf["OVPN_HOST"]:
    sys.exit(0)
data = {
    "host": conf["OVPN_HOST"],
    "port": int(conf["OVPN_PORT"]),
    "network": conf["OVPN_NETWORK"],
    "auth_mode": conf["OVPN_AUTH_MODE"],
    "user_domain": conf["OVPN_USER_DOMAIN"],
    "totp_required": om.is_true(conf["OVPN_TOTP_REQUIRED"]),
    "expose_samba": om.is_true(conf["OVPN_EXPOSE_SAMBA"]),
}
response = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "configure-module failed")
