import json
import sys
import agent
import ovpn_module as om

request = json.load(sys.stdin)
original = request["environment"]

# OVPN_TUN and OVPN_TUN_IP stay those of this instance: the tun belongs to the node
for key in om.SETTINGS_DEFAULTS:
    if key in original:
        agent.set_env(key, original[key])
agent.dump_env()
