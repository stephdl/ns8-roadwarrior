{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "add-spoke output",
    "$id": "http://schema.nethserver.org/roadwarrior/add-spoke-output.json",
    "description": "What the node needs to join the hub",
    "examples": [
        {
            "ip": "10.8.1.3/23",
            "rw_network": "10.8.0.0/24",
            "ca": "-----BEGIN CERTIFICATE-----\n...",
            "cert": "-----BEGIN CERTIFICATE-----\n..."
        }
    ],
    "type": "object",
    "required": [
        "ip",
        "rw_network",
        "ca",
        "cert"
    ],
    "properties": {
        "ip": {
            "type": "string",
            "description": "Address of the node tun, with the prefix that also covers the users network"
        },
        "rw_network": {
            "type": "string",
            "description": "Network of the users of the hub"
        },
        "ca": {
            "type": "string"
        },
        "cert": {
            "type": "string"
        }
    }
}
