# Another roadwarrior instance joins this hub. The core gives its identity, the input cannot.

import json
import os
import sys
import agent
import ovpn_module as om

request = json.load(sys.stdin)
if om.mode() != "hub":
    om.fail_validation("mode", om.mode(), "not_a_hub")
caller = os.environ.get("AGENT_TASK_USER", "")
module_id = caller.removeprefix("module/")
if not caller.startswith("module/roadwarrior") or module_id == os.environ["MODULE_ID"]:
    om.fail_validation("csr", "", "caller_not_allowed")

rdb = agent.redis_connect(use_replica=True)
node_id = rdb.hget("cluster/module_node", module_id)
if not node_id:
    om.fail_validation("csr", "", "caller_not_allowed")
if not om.server_running():
    om.fail_validation("mode", "hub", "server_not_running")

joined = om.register_spoke(module_id, node_id, request["csr"], request.get("expose_samba", False))
om.apply_runtime(om.write_runtime(rdb))
json.dump(joined, fp=sys.stdout)
