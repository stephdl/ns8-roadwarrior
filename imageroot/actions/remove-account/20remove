# Revoke the certificate before forgetting the account: the CRL keeps the old profile out

import json
import sys
import ovpn_module as om

request = json.load(sys.stdin)
name = request["name"]
om.require_server()
accounts = om.load_accounts()
if name not in accounts:
    om.fail_validation("name", name, "account_not_found")
if om.pki_list().get(name, {}).get("status") == "valid":
    om.podman_exec("ovpn-pki", "revoke", name)
om.podman_exec("ovpn-mgmt", "kill", name, check=False)
totp = om.load_totp()
if totp.pop(name, None) is not None:
    om.save_totp(totp)
del accounts[name]
om.save_accounts(accounts)
