{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "request-spoke-certificate output",
    "$id": "http://schema.nethserver.org/roadwarrior/request-spoke-certificate-output.json",
    "description": "Certificate request of this node, to pass to add-spoke of the hub",
