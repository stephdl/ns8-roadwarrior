import json
import sys
import ovpn_module as om

request = json.load(sys.stdin)
name = request["name"]
om.require_server()
accounts = om.load_accounts()
# Logins compare names without case: "Alice" and "alice" would be the same user
if name.lower() in {account.lower() for account in accounts}:
    om.fail_validation("name", name, "account_exists")
if name == "server":
    om.fail_validation("name", name, "name_reserved")
om.podman_exec("ovpn-pki", "add", name)
accounts[name] = {"created": om.now()}
om.save_accounts(accounts)
