{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "remove-spoke input",
    "$id": "http://schema.nethserver.org/roadwarrior/remove-spoke-input.json",
    "description": "Remove a node from this hub. A roadwarrior instance that calls it removes itself and sends no module_id.",
    "examples": [
        {
            "module_id": "roadwarrior2"
        }
    ],
    "type": "object",
    "properties": {
        "module_id": {
            "type": "string",
            "pattern": "^roadwarrior[0-9]+$"
        }
    }
}
