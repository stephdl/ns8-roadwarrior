# A new certificate for the same account: the authenticator and the history stay,
# the old profile stops working and the user downloads a new one

import json
import sys
import ovpn_module as om

request = json.load(sys.stdin)
name = request["name"]
om.require_server()
om.require_enabled_account(name)
om.podman_exec("ovpn-pki", "renew", name)
om.podman_exec("ovpn-mgmt", "kill", name, check=False)
