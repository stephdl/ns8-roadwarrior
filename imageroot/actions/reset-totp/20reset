# For a lost phone. With totp_required the user cannot log in until a new enrollment.

import json
import sys
import ovpn_module as om

request = json.load(sys.stdin)
name = request["name"]
om.require_enabled_account(name)
totp = om.load_totp()
if totp.pop(name, None) is not None:
    om.save_totp(totp)
