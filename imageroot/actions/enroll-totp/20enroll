# Create a new secret, not yet active: confirm-totp turns it on once the user proves the app works.
# The secret is returned once and never again.

import base64
import json
import os
import secrets
import sys
import urllib.parse
import ovpn_module as om

request = json.load(sys.stdin)
name = request["name"]
if os.environ.get("OVPN_AUTH_MODE") != "certificate_password":
    om.fail_validation("name", name, "totp_needs_password")
if name not in om.load_accounts():
    om.fail_validation("name", name, "account_not_found")

secret = base64.b32encode(secrets.token_bytes(20)).decode().rstrip("=")
totp = om.load_totp()
# A confirmed secret stays active until the new one is confirmed
entry = totp.get(name, {})
entry["pending"] = secret
totp[name] = entry
om.save_totp(totp)

issuer = f"OpenVPN {os.environ.get('OVPN_HOST', '')}".strip()
label = urllib.parse.quote(f"{issuer}:{name}")
uri = f"otpauth://totp/{label}?" + urllib.parse.urlencode({"secret": secret, "issuer": issuer})
json.dump({"secret": secret, "uri": uri}, fp=sys.stdout)
