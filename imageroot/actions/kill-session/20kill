# The client gets HALT and stops, and its session token stops working

import json
import sys
import ovpn_module as om

request = json.load(sys.stdin)
om.require_server()
if om.podman_exec("ovpn-mgmt", "kill", request["name"], check=False).returncode != 0:
    om.fail_validation("name", request["name"], "no_session")
