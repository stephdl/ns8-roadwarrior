# Site-to-site server of a hub: the nodes join it, the forward rules of the pod live with it.

[Unit]
Description=Podman openvpn-s2s.service
BindsTo=openvpn-hub.service
After=openvpn-hub.service openvpn-hub-server.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
Type=forking
ExecStartPre=/bin/rm -f %t/openvpn-s2s.pid %t/openvpn-s2s.ctr-id
ExecStartPre=runagent ovpn-write-runtime
ExecStart=/usr/bin/podman run --conmon-pidfile %t/openvpn-s2s.pid \
    --cidfile %t/openvpn-s2s.ctr-id --cgroups=no-conmon \
    --replace -d --name openvpn-s2s \
    --pod openvpn-hub \
    --cap-add=NET_ADMIN \
    --device /dev/net/tun \
    --security-opt label=disable \
    --volume openvpn-data:/etc/openvpn:z \
    --volume ./ovpn:/run/ovpn:ro,z \
    --volume ./secrets:/run/ovpn-secrets:ro,z \
    ${ROADWARRIOR_SERVER_IMAGE} s2s
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/openvpn-s2s.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/openvpn-s2s.ctr-id
PIDFile=%t/openvpn-s2s.pid
SyslogIdentifier=%u

[Install]
WantedBy=default.target
