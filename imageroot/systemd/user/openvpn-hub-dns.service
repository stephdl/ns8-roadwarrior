# Resolver of the users of a hub. Each app name answers with the address of the node that serves it.

[Unit]
Description=Podman openvpn-hub-dns.service
BindsTo=openvpn-hub.service
After=openvpn-hub.service openvpn-hub-server.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
Type=forking
ExecStartPre=/bin/rm -f %t/openvpn-hub-dns.pid %t/openvpn-hub-dns.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/openvpn-hub-dns.pid \
    --cidfile %t/openvpn-hub-dns.ctr-id --cgroups=no-conmon \
    --replace -d --name openvpn-dns \
    --pod openvpn-hub \
    --volume ./ovpn:/run/ovpn:ro,z \
    ${ROADWARRIOR_SERVER_IMAGE} dnsmasq
# dnsmasq reads the hosts file again on SIGHUP
ExecReload=/usr/bin/podman kill -s HUP openvpn-dns
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/openvpn-hub-dns.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/openvpn-hub-dns.ctr-id
PIDFile=%t/openvpn-hub-dns.pid
SyslogIdentifier=%u

[Install]
WantedBy=default.target
