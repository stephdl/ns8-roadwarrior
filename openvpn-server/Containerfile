FROM docker.io/library/alpine:3.22.6
RUN apk add --no-cache \
        openvpn \
        easy-rsa \
        dnsmasq \
        python3 \
        py3-ldap3
COPY entrypoint.sh /entrypoint.sh
COPY ovpn-auth ovpn-pki ovpn-mgmt ovpn-history /usr/local/bin/
ENTRYPOINT ["/entrypoint.sh"]
CMD ["openvpn"]
