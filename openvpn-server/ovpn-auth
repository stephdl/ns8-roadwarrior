# auth-user-pass-verify script. The check runs in a child process and writes its result to
# auth_control_file, so a slow LDAP server does not stall the other clients.
# The certificate name must match the user name: one user cannot log in with the certificate of another.
# /run/ovpn/auth.json holds the LDAP settings, /run/ovpn-secrets the bind password and the TOTP secrets.
#
# "ovpn-auth totp-check" reads {"secret", "code"} on stdin and exits 0 if the code is right.
# The module uses it to confirm an enrollment, so both sides share one TOTP check.

import base64
import fcntl
import hashlib
import hmac
import json
import os
import struct
import subprocess
import sys
import time

import ldap3
from ldap3.utils.conv import escape_filter_chars

TOTP_STEP = 30
# One step before and after, for clocks that drift a little
TOTP_WINDOW = 1
# Last code step used by each user: a code works once
TOTP_USED = "/etc/openvpn/totp-used.json"


class Refused(Exception):
    def __init__(self, reason, message):
        super().__init__(message)
        # Short code for the login history
        self.reason = reason


def log(message):
    print(f"ovpn-auth: {message}", file=sys.stderr, flush=True)


def totp_counter(secret, code):
    """Return the time step that matches the code, or None"""
    if not (code.isdigit() and len(code) == 6):
        return None
    key = base64.b32decode(secret.upper() + "=" * (-len(secret) % 8))
    now = int(time.time()) // TOTP_STEP
    for counter in range(now - TOTP_WINDOW, now + TOTP_WINDOW + 1):
        digest = hmac.new(key, struct.pack(">Q", counter), hashlib.sha1).digest()
        offset = digest[-1] & 0x0F
        value = (struct.unpack(">I", digest[offset:offset + 4])[0] & 0x7FFFFFFF) % 1000000
        if hmac.compare_digest(f"{value:06d}", code):
            return counter
    return None


def consume_totp(username, counter):
    with open(TOTP_USED + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(TOTP_USED) as f:
                used = json.load(f)
        except (FileNotFoundError, ValueError):
            used = {}
        if counter <= used.get(username, -1):
            raise Refused("code_reused", f"user {username!r}: authenticator code already used")
        used[username] = counter
        tmp = TOTP_USED + ".tmp"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(used, f)
        os.replace(tmp, TOTP_USED)


def ldap_ok(conf, username, password):
    attr = "sAMAccountName" if conf["schema"] == "ad" else "uid"
    server = ldap3.Server(conf["host"], port=int(conf["port"]), connect_timeout=5)
    with open("/run/ovpn-secrets/ldap-bind-password") as f:
        bind_password = f.read().strip()
    with ldap3.Connection(server, conf["bind_dn"], bind_password, auto_bind=True, receive_timeout=10) as conn:
        conn.search(conf["base_dn"], f"(&(objectClass=person)({attr}={escape_filter_chars(username)}))",
                    attributes=[], size_limit=2)
        if len(conn.entries) != 1:
            return False
        user_dn = conn.entries[0].entry_dn
    try:
        with ldap3.Connection(server, user_dn, password, auto_bind=True, receive_timeout=10):
            return True
    except ldap3.core.exceptions.LDAPBindError:
        return False


def check(username, password, common_name):
    # LDAP names ignore case: "Alice" is the user of the certificate "alice"
    if username.lower() != common_name.lower():
        raise Refused("certificate_mismatch", f"user {username!r} does not match certificate {common_name!r}")
    username = common_name

    with open("/run/ovpn/auth.json") as f:
        conf = json.load(f)
    try:
        with open("/run/ovpn-secrets/totp.json") as f:
            totp = json.load(f).get(username, {})
    except FileNotFoundError:
        totp = {}

    code = ""
    # With static-challenge the client sends SCRV1:<base64 password>:<base64 code>
    if password.startswith("SCRV1:"):
        try:
            _, b64pass, b64code = password.split(":", 2)
            password = base64.b64decode(b64pass).decode()
            code = base64.b64decode(b64code).decode().strip()
        except ValueError:
            raise Refused("malformed_response", f"user {username!r}: malformed challenge response")

    counter = None
    if totp.get("confirmed"):
        counter = totp_counter(totp["secret"], code)
        if counter is None:
            raise Refused("wrong_code", f"user {username!r}: wrong or missing authenticator code")
    elif conf.get("totp_required"):
        raise Refused("totp_not_enrolled", f"user {username!r}: authenticator required but not enrolled")

    if not password or not ldap_ok(conf, username, password):
        raise Refused("wrong_password", f"user {username!r}: wrong password")
    # Spend the code last: a wrong password must not burn it
    if counter is not None:
        consume_totp(username, counter)
    log(f"user {username!r} accepted")


def run_check(username, password, common_name):
    """Return True if the client may log in, and record a refusal in the history"""
    try:
        check(username, password, common_name)
        return True
    except Refused as exc:
        log(str(exc))
        reason = exc.reason
    except Exception as exc:
        log(f"error: {exc}")
        reason = "error"
    try:
        # OpenVPN runs this script without PATH
        subprocess.run(["/usr/local/bin/ovpn-history", "refused", common_name, reason], check=False)
    except OSError as exc:
        log(f"cannot record the refused login: {exc}")
    return False


def totp_check():
    request = json.load(sys.stdin)
    sys.exit(0 if totp_counter(request["secret"], request["code"]) is not None else 1)


def main():
    common_name = os.environ.get("common_name", "")
    # The session token was checked by OpenVPN itself: the user already passed the full check
    if os.environ.get("session_state") in ("Authenticated", "AuthenticatedEmptyUser"):
        log(f"user {common_name!r} renewed with a session token")
        sys.exit(0)
    # The password field holds the old token: an LDAP bind with it would count as a bad password
    if os.environ.get("session_state") in ("Expired", "ExpiredEmptyUser", "Invalid"):
        log(f"user {common_name!r}: session token {os.environ['session_state'].lower()}")
        sys.exit(1)

    # OpenVPN deletes the credentials file when this process exits, read it first
    with open(sys.argv[1]) as f:
        lines = f.read().split("\n")
    username, password = lines[0], lines[1] if len(lines) > 1 else ""

    control_file = os.environ.get("auth_control_file")
    if not control_file:
        sys.exit(0 if run_check(username, password, common_name) else 1)

    if os.fork() > 0:
        # Exit code 2: the result comes later through auth_control_file
        sys.exit(2)
    os.setsid()
    result = "0"
    try:
        result = "1" if run_check(username, password, common_name) else "0"
    finally:
        # Always answer, or the client waits until the handshake times out
        with open(control_file, "w") as f:
            f.write(result)
        os._exit(0)


if __name__ == "__main__":
    if sys.argv[1:2] == ["totp-check"]:
        totp_check()
    main()
