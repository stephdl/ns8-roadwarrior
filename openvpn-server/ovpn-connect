# client-connect hook. It runs for every new session, in every auth mode, so a disabled
# account is refused here even with a valid certificate and no password check.
# /run/ovpn/disabled.json lists the disabled accounts, written by the module.

import os
import subprocess
import sys

from ovpn_common import is_disabled

name = os.environ.get("common_name", "")

if is_disabled(name):
    print(f"ovpn-connect: account {name!r} is disabled", file=sys.stderr, flush=True)
    subprocess.run(["/usr/local/bin/ovpn-history", "refused", name, "account_disabled"], check=False)
    sys.exit(1)

# OpenVPN runs this hook without PATH
sys.exit(subprocess.run(["/usr/local/bin/ovpn-history", "connect"], check=False).returncode)
