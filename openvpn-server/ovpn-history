# Login history of the VPN clients, one JSON object per line.
#
#   ovpn-history connect               client-connect hook, reads the OpenVPN environment
#   ovpn-history disconnect            client-disconnect hook
#   ovpn-history refused NAME REASON   called by ovpn-auth, reads trusted_ip from the environment
#   ovpn-history list [NAME]           print the events as a JSON array, newest first
#   ovpn-history last                  print {"name": time} of the last login of each client

import fcntl
import json
import os
import sys
import time

HISTORY = "/etc/openvpn/history.jsonl"
# Last login time of each account, so the accounts list does not read the whole history
LAST_LOGIN = "/etc/openvpn/last-login.json"
# Keep the file small: when it grows past MAX_BYTES, drop the oldest events down to KEEP_LINES.
# The size check avoids reading the whole file in the connect hook, which blocks every client.
MAX_BYTES = 4 * 1024 * 1024
KEEP_LINES = 15000


def env_int(name):
    try:
        return int(os.environ.get(name, ""))
    except ValueError:
        return 0


def append(event):
    event["time"] = int(time.time())
    with open(HISTORY + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(HISTORY, "a") as f:
            f.write(json.dumps(event) + "\n")
            size = f.tell()
        if event["event"] == "login":
            last = read_last_login()
            last[event["name"]] = event["time"]
            tmp = LAST_LOGIN + ".tmp"
            with open(tmp, "w") as f:
                json.dump(last, f)
            os.replace(tmp, LAST_LOGIN)
        if size > MAX_BYTES:
            with open(HISTORY) as f:
                lines = f.readlines()
            tmp = HISTORY + ".tmp"
            with open(tmp, "w") as f:
                f.writelines(lines[-KEEP_LINES:])
            os.replace(tmp, HISTORY)


def read_last_login():
    try:
        with open(LAST_LOGIN) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        # Built once from the history, for a volume made before the index existed
        last = {}
        for event in read():
            if event.get("event") == "login":
                last[event.get("name", "")] = event["time"]
        return last


def read():
    try:
        with open(HISTORY) as f:
            lines = f.readlines()
    except FileNotFoundError:
        return []
    events = []
    for line in lines:
        try:
            events.append(json.loads(line))
        except ValueError:
            continue
    return events


def main():
    command = sys.argv[1:2]
    if command == ["connect"]:
        append({
            "name": os.environ.get("common_name", ""),
            "event": "login",
            "address": os.environ.get("trusted_ip", ""),
            "vpn_address": os.environ.get("ifconfig_pool_remote_ip", ""),
        })
    elif command == ["disconnect"]:
        append({
            "name": os.environ.get("common_name", ""),
            "event": "logout",
            "address": os.environ.get("trusted_ip", ""),
            "vpn_address": os.environ.get("ifconfig_pool_remote_ip", ""),
            "duration": env_int("time_duration"),
            "bytes_received": env_int("bytes_received"),
            "bytes_sent": env_int("bytes_sent"),
        })
    elif command == ["refused"] and len(sys.argv) == 4:
        append({
            "name": sys.argv[2],
            "event": "refused",
            "address": os.environ.get("untrusted_ip") or os.environ.get("trusted_ip", ""),
            "reason": sys.argv[3],
        })
    elif command == ["list"]:
        name = sys.argv[2] if len(sys.argv) > 2 else None
        events = [e for e in read() if name is None or e.get("name") == name]
        json.dump(events[::-1], sys.stdout)
    elif command == ["last"]:
        json.dump(read_last_login(), sys.stdout)
    else:
        print("usage: ovpn-history connect|disconnect|refused NAME REASON|list [NAME]|last", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
